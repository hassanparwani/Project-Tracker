rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Global Primitives ---
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isBootstrappedAdmin() {
      return isVerifiedUser() && request.auth.token.email == 'hassanparwani12@gmail.com';
    }

    function isAdmin() {
      return isVerifiedUser() && (
        isBootstrappedAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // --- Validation Blueprints ---
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'role', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'displayName', 'role', 'createdAt', 'updatedAt']) &&
        data.uid is string && data.uid == userId && isValidId(data.uid) &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80 &&
        data.role is string && data.role in ['admin', 'team'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidUserPrivateInfo(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'email', 'updatedAt']) &&
        data.uid is string && data.uid == userId && isValidId(data.uid) &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 200 &&
        data.updatedAt is timestamp;
    }

    function isValidWorkstream(ws) {
      return ws is string && ws in ['PMO', 'Payer Contracts', 'Recruitment', 'MSSP & C-SNP', 'Legal'];
    }

    function isValidStatus(st) {
      return st is string && st in ['Not started', 'In progress', 'Needs attention', 'Blocked', 'Done'];
    }

    function isValidRoadmapItem(data, itemId) {
      return data.keys().hasAll(['id', 'ws', 't', 'a', 'r', 'c', 's', 'd', 'dl', 'st', 'n', 'visibility', 'createdBy', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'ws', 't', 'a', 'r', 'c', 's', 'd', 'dl', 'st', 'n', 'visibility', 'createdBy', 'createdAt', 'updatedAt']) &&
        data.id is string && data.id == itemId && isValidId(data.id) &&
        isValidWorkstream(data.ws) &&
        data.t is string && data.t.size() >= 1 && data.t.size() <= 600 &&
        data.a is string && data.a.size() <= 600 &&
        data.r is string && data.r.size() <= 600 &&
        data.c is string && data.c.size() <= 600 &&
        data.s is string && data.s.size() <= 32 &&
        data.d is string && data.d.size() <= 32 &&
        data.dl is string && data.dl.size() <= 100 &&
        isValidStatus(data.st) &&
        data.n is string && data.n.size() <= 1000 &&
        data.visibility is string && data.visibility == 'workspace' &&
        data.createdBy is string && isValidId(data.createdBy) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidChangesList(changes) {
      return changes is list &&
        changes.size() <= 10 &&
        (changes.size() == 0 || (changes[0] is string && changes[0].size() <= 300));
    }

    function isValidAuditLogEntry(data) {
      return data.keys().hasAll(['at', 'who', 'uid', 'role', 'itemId', 't', 'act', 'changes', 'visibility', 'createdAt']) &&
        data.keys().hasOnly(['at', 'who', 'uid', 'role', 'itemId', 't', 'act', 'changes', 'visibility', 'createdAt']) &&
        data.at is string && data.at.size() >= 1 && data.at.size() <= 64 &&
        data.who is string && data.who.size() >= 1 && data.who.size() <= 80 &&
        data.uid is string && isValidId(data.uid) &&
        (isSignedIn() ? data.uid == request.auth.uid : data.uid == 'anonymous') &&
        data.role is string && data.role in ['admin', 'team', 'system', 'guest'] &&
        data.itemId is string && data.itemId.size() <= 128 &&
        data.t is string && data.t.size() <= 600 &&
        data.act is string && data.act in ['Seeded', 'Created', 'Edited', 'Deleted'] &&
        isValidChangesList(data.changes) &&
        data.visibility is string && data.visibility == 'workspace' &&
        data.createdAt is timestamp;
    }

    // --- Collection: /users/{userId} ---
    match /users/{userId} {
      allow get: if isValidId(userId) && isVerifiedUser() && (request.auth.uid == userId || isAdmin());
      allow list: if isVerifiedUser() && (existing().uid == request.auth.uid || isBootstrappedAdmin());

      allow create: if isValidId(userId) &&
        isVerifiedUser() &&
        request.auth.uid == userId &&
        isValidUserProfile(incoming(), userId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        (
          incoming().role == 'team' ||
          (incoming().role == 'admin' && isBootstrappedAdmin())
        );

      allow update: if isValidId(userId) &&
        isVerifiedUser() &&
        isValidUserProfile(incoming(), userId) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'role', 'updatedAt'])) ||
          (request.auth.uid == userId && incoming().role == existing().role && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'updatedAt']))
        );

      allow delete: if false;

      // Isolated PII subcollection
      match /private/{docId} {
        allow get: if isValidId(userId) && isValidId(docId) && isVerifiedUser() && request.auth.uid == userId;
        allow list: if false;
        allow create: if isValidId(userId) && isValidId(docId) && isVerifiedUser() &&
          request.auth.uid == userId &&
          isValidUserPrivateInfo(incoming(), userId) &&
          incoming().updatedAt == request.time;
        allow update: if isValidId(userId) && isValidId(docId) && isVerifiedUser() &&
          request.auth.uid == userId &&
          isValidUserPrivateInfo(incoming(), userId) &&
          incoming().uid == existing().uid &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly(['email', 'updatedAt']);
        allow delete: if false;
      }
    }

    // --- Collection: /roadmap_items/{itemId} (Open Workspace Collaboration) ---
    match /roadmap_items/{itemId} {
      allow get: if isValidId(itemId) && existing().visibility == 'workspace';
      allow list: if existing().visibility == 'workspace';

      allow create: if isValidId(itemId) &&
        isValidRoadmapItem(incoming(), itemId) &&
        (isSignedIn() ? incoming().createdBy == request.auth.uid : incoming().createdBy == 'anonymous') &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isValidId(itemId) &&
        isValidRoadmapItem(incoming(), itemId) &&
        incoming().id == existing().id &&
        incoming().visibility == existing().visibility &&
        incoming().createdBy == existing().createdBy &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['ws', 't', 'a', 'r', 'c', 's', 'd', 'dl', 'st', 'n', 'updatedAt']);

      allow delete: if isValidId(itemId);
    }

    // --- Collection: /audit_logs/{logId} (Open Append-Only Audit Trail) ---
    match /audit_logs/{logId} {
      allow get: if isValidId(logId) && existing().visibility == 'workspace';
      allow list: if existing().visibility == 'workspace';

      allow create: if isValidId(logId) &&
        isValidAuditLogEntry(incoming()) &&
        incoming().createdAt == request.time;

      allow update: if false;
      allow delete: if false;
    }
  }
}
